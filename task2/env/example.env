# ============================================
# TaskFlow — Environment Variable Reference
# ============================================
# Copy this file to backend.env and frontend.env
# and adjust values for your environment.
# ============================================

# --- Backend (env/backend.env) ---

# DB_HOST         PostgreSQL hostname (Docker service name or external)
DB_HOST=db
# DB_PORT         PostgreSQL port
DB_PORT=5432
# DB_USER         Database user
DB_USER=postgres
# DB_PASSWORD     Database password
DB_PASSWORD=postgres
# DB_NAME         Database name
DB_NAME=taskflow

# POSTGRES_USER   Postgres user (same value, used by postgres image)
POSTGRES_USER=postgres
# POSTGRES_PASSWORD  Postgres password
POSTGRES_PASSWORD=postgres
# POSTGRES_DB     Postgres database name
POSTGRES_DB=taskflow

# CORS_ORIGIN     Allowed CORS origin (set to frontend URL, e.g. http://localhost:8080)
CORS_ORIGIN=http://localhost:8080

# --- Frontend (env/frontend.env) ---
# Note: VITE_API_BASE_URL is set as a build arg in docker-compose.yml,
# not loaded from this file at runtime.
